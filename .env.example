PORT=3100
DEFAULT_PROVIDER=x

# Model routing. Provider names must exist in settings.json.
OPUS_MODEL=x/kimi2.6,y/gemini
SONNET_MODEL=y/gemini
HAIKU_MODEL=x/fast-model

REQUEST_TIMEOUT_MS=600000

# Token/debug optimization flags.
TOKEN_DEBUG=0
TOOL_RESULT_DEDUPE=0
TOOL_RESULT_MAX_CHARS=0
TOOL_RESULT_HEAD_LINES=80
TOOL_RESULT_TAIL_LINES=80
TOOL_SCHEMA_STRIP_DESCRIPTIONS=0

# CORS: unset for localhost-only behavior, or set to comma-separated origins.
# ALLOWED_ORIGINS=http://localhost:3000
