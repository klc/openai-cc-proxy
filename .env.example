# Server
PORT=3100

# Providers
# Claude Code sends ANTHROPIC_API_KEY to this proxy as x-api-key. That works
# when all selected models use the same provider/key. For mixed providers, set
# provider-specific keys below.
DEFAULT_PROVIDER=opencode

OPENCODE_API_KEY=
OPENROUTER_API_KEY=

# OpenCode Go OpenAI-compatible API base URL.
OPENCODE_API_URL=https://opencode.ai/zen/go/v1

# OpenRouter OpenAI-compatible API base URL.
OPENROUTER_API_URL=https://openrouter.ai/api/v1
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=openai-cc-proxy

# Claude Code model families are mapped to these provider/model entries.
# Use provider/model or provider:model. Comma-separated pools still work.
OPUS_MODEL=opencode/kimi-k2.6

SONNET_MODEL=openrouter/deepseek-v4-pro

HAIKU_MODEL=opencode/deepseek-v4-flash

# Timeout for long-running agent tasks.
REQUEST_TIMEOUT_MS=600000

# Claude Code usage example:
# export ANTHROPIC_BASE_URL="http://localhost:3100"
# export ANTHROPIC_API_KEY="<opencode-go-api-key>"
# claude
