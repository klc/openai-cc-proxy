# Server
PORT=3100

# OpenCode Go
# Claude Code sends ANTHROPIC_API_KEY to this proxy as x-api-key.
# Leave this empty if you do not want to hardcode the key here.
OPENCODE_API_KEY=

# OpenCode Go OpenAI-compatible API base URL.
OPENCODE_API_URL=https://opencode.ai/zen/go/v1

# Claude Code opus model names are mapped to this OpenCode Go model.
OPENCODE_OPUS_MODEL=kimi-k2.6

# Claude Code sonnet model names are mapped to this OpenCode Go model.
OPENCODE_SONNET_MODEL=deepseek-v4-pro

# Claude Code haiku model names are mapped to this OpenCode Go model.
OPENCODE_HAIKU_MODEL=deepseek-v4-flash

# Timeout for long-running agent tasks.
REQUEST_TIMEOUT_MS=600000

# Claude Code usage example:
# export ANTHROPIC_BASE_URL="http://localhost:3100"
# export ANTHROPIC_API_KEY="<opencode-go-api-key>"
# claude
